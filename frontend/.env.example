# URL do backend, usada no BUILD pelo rewrite do Next (/api/v1/* -> API_URL/api/v1/*)
API_URL=http://localhost:8000
# Base das chamadas feitas pelo navegador (mesmo domínio, via rewrite)
NEXT_PUBLIC_API_BASE=/api/v1

# URL do Meu Dashboard do usuário (aplicação do Desafio 02). Deixe vazio até a integração.
NEXT_PUBLIC_D02_DASHBOARD_URL=
# Página pública da Residência Tecnológica UCB / Porto Digital, caso a equipe defina o endereço.
NEXT_PUBLIC_RESIDENCIA_URL=
