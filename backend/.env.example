# Copie para .env e ajuste. Nunca commite o .env.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://safepass:safepass@localhost:5432/safepass

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-secret-change-me-please-32b
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
PASSWORD_RESET_MINUTES=30

# true em produção (HTTPS). Em dev (http://localhost) precisa ser false.
COOKIE_SECURE=false
# Lista em JSON
CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000
# true apenas atrás de proxy confiável (o Next.js repassa X-Forwarded-For)
TRUST_FORWARDED_FOR=false

# Gateway ainda não definido: "simulated" ativa o plano na hora (somente demo)
PAYMENT_GATEWAY=simulated

# E-mail (em dev: Mailpit em http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM=SAFEpass <no-reply@safepass.local>

# Seed (scripts/seed.py)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
SEED_DEMO_DATA=false
